# =====================================================================
#  Railway -> your service -> Variables -> "RAW Editor" -> paste, then
#  replace every <PLACEHOLDER>. Do not commit this file with real values.
# =====================================================================

# ---------------- REQUIRED ----------------
BOT_TOKEN=<token from @BotFather>
# EXTERNAL persistent Redis (Upstash / Redis Cloud ...). Pick the SAME REGION as this Railway service.
REDIS_URL=<rediss://default:password@host:port>
# Private storage channel ID (looks like -1001234567890)
STORAGE_CHANNEL_ID=<-100xxxxxxxxxx>
# Numeric Telegram user IDs of admins, comma separated (NOT usernames)
ADMIN_IDS=<123456789>
BOT_USERNAME=Storage_Drop_Bot
# Your public Railway domain, https, no trailing slash
BASE_URL=<https://your-app.up.railway.app>
NODE_ENV=production

# ---------------- RECOMMENDED ----------------
# Encrypts backups sent to Telegram. Keep a copy OUTSIDE Railway. 16+ characters.
BACKUP_ENCRYPTION_KEY=<long secret passphrase>
BACKUP_INTERVAL_HOURS=24
# Private chat/channel that receives backups (optional; default = the storage channel)
# BACKUP_CHAT_ID=<-100xxxxxxxxxx>
# Add AFTER the first successful start: copy the "DB fingerprint" shown by /stats
# DB_FINGERPRINT=<value from /stats>
# Refuse to start if REDIS_URL is a Railway-hosted Redis
REQUIRE_EXTERNAL_DB=true

# ---------------- OPTIONAL (defaults shown) ----------------
DASHBOARD_TITLE=FILE VAULT
APP_NAME=Storage Drop
DEVELOPER_NAME=Sahin
DEVELOPER_HANDLE=Sahin_09022
FILE_TTL_SECONDS=0
MAX_FILE_SIZE_MB=2000
EXPIRED_OWNER_ACCESS=true
TRUST_PROXY_HOPS=1
LOG_LEVEL=info
MAX_UPLOADS_PER_MINUTE=10
MAX_DOWNLOADS_PER_MINUTE=30
MAX_STARTS_PER_MINUTE=10
MAX_CALLBACKS_PER_MINUTE=60
MAX_SEARCH_PER_MINUTE=15
MAX_SHARE_CREATES_PER_MINUTE=10
MAX_PASSWORD_ATTEMPTS=5
PASSWORD_ATTEMPT_WINDOW_MINUTES=15

# ---------------- FORCE SUBSCRIBE (channels are managed in Admin Panel -> Force Subscribe) ----------------
# One-time import of your existing required channel. The bot must be an ADMIN of that channel (otherwise it is
# imported disabled). Format: @username-or--100id|Display name|Join button text|Join URL ; next entry ...
FORCE_SUB_SEED=@TheRoyalZone|The Royal Zone|📢 Join The Royal Zone|https://t.me/TheRoyalZone
# Seconds a positive membership check is reused (0 = ask Telegram on every protected interaction)
FORCE_SUB_CACHE_SECONDS=10

# ---------------- DO NOT SET (unless stated) ----------------
# ALLOW_EMPTY_DB_INIT=true   -> ONLY for a brand-new installation with a brand-new empty Redis, first start only.
#                               Your existing database does not need it.
# PORT                       -> Railway sets it automatically.

# ---------------- DELIVERY POLICY (public links; admins can change live: /autodelete /forwardlock or Admin -> Settings) ----------------
AUTO_DELETE_SECONDS=600
FORWARD_LOCK_SECONDS=120
